#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# build/ is the local meson directory, so the build target cannot be a
# pattern rule or an un-phony file target.
build:
	dh build --buildsystem=meson
.PHONY: build

%:
	dh $@ --buildsystem=meson

override_dh_auto_test:
	xvfb-run -a dh_auto_test -- --print-errorlogs
